# Python bytecode + caches
__pycache__/
*.py[cod]
*$py.class

# Test + coverage caches
.pytest_cache/
.coverage
htmlcov/

# Generated outputs (regenerated by ./run.sh graphs / components)
out/

# Generated wordbank (produced at image build time by scripts/build_wordbank.py)
data/

# NLTK downloads when running build_wordbank.py locally outside the container
nltk_data/

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# CDK build artifacts (added pre-emptively so the upcoming infra/ doesn't
# pollute the repo).
cdk.out/
.cdk.staging/
node_modules/

# Local env files
.env
.env.local

# Python virtual environments (e.g. infra/.venv/ for local CDK dev)
.venv/
**/.venv/
